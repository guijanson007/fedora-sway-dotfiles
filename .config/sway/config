# ==============================================================================
# Base Variables & Hardware Preferences (Preserved)
# ==============================================================================
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term kitty
set $browser flatpak run app.zen_browser.zen
set $file_manager nautilus --new-window

# Keep Sway shortcuts active when a VM or remote desktop requests inhibition.
seat seat0 shortcuts_inhibitor disable

# Wallpaper
output * bg ~/Pictures/Wallpapers/wallpaper.png fill

# Application Launcher
set $rofi_cmd rofi -terminal '$term'
#set $menu $rofi_cmd -show combi -combi-modes drun#run -modes combi
set $menu ~/.config/rofi/launcher.sh

# ==============================================================================
# Monitor & Display Configuration 
# ==============================================================================
output * adaptive_sync on

# External monitor
output HDMI-A-2 mode 1920x1080@60Hz position 0,0 enable

# Laptop monitor
output eDP-1 mode 1920x1080@60Hz position 1920,0 scale 1.25 enable


# ==============================================================================
# Workspace Output Assignments
# ==============================================================================
# Workspaces 1-4 on the external monitor
workspace 1 output HDMI-A-2
workspace 2 output HDMI-A-2
workspace 3 output HDMI-A-2
workspace 4 output HDMI-A-2

# Workspaces 5-7 on the laptop monitor (eDP-1)
workspace 5 output eDP-1
workspace 6 output eDP-1
workspace 7 output eDP-1

# ==============================================================================
# Aesthetic Framework (Imported from Ruixi-rebirth)
# ==============================================================================
# Typography
font pango:JetBrainsMono Nerd Font 10

# Window Borders & Margins
default_border pixel 3
default_floating_border pixel 3
smart_borders on

gaps inner 5
gaps outer 0

# Color Palette: Focused pink accent with muted Nordic dark tones
# class                 border  bground text    indicator child_border
include ~/.config/sway/theme.conf

# GTK Theme & Cursor Synchronizer
set $gnome-schema org.gnome.desktop.interface
exec_always {
    gsettings set $gnome-schema icon-theme 'Papirus-Dark'
    gsettings set $gnome-schema cursor-theme 'Catppuccin-cursor'
    gsettings set $gnome-schema font-name 'JetBrainsMono Nerd Font 12'
}

# Set XDG_CURRENT_DESKTOP for proper wayland support
exec --no-startup-id dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway

# Dynamic Wallpaper Service
# Disabled: conflicts with theme wallpapers (loops a missing folder, respawned on every reload)
#exec_always --no-startup-id ~/.config/sway/dynamic_wallpaper.sh $
# Autotiling service
exec_always autotiling

# App Opacity Profiles
for_window [app_id="telegram"] opacity 0.95
for_window [app_id="danmufloat"] opacity 0.80
for_window [app_id="icalingua"] opacity 0.95
for_window [class="netease-cloud-music"] opacity 0.90

# Window Rules & Dimensions
for_window [app_id="pop-up"] floating enable
for_window [app_id="bubble"] floating enable 
for_window [app_id="task_dialog"] floating enable
for_window [app_id="Preferences"] floating enable
for_window [app_id="dialog"] floating enable 
for_window [app_id="menu"] floating enable
for_window [app_id="Organizer"] floating enable
for_window [app_id="About"] floating enable
for_window [app_id="toolbox"] floating enable
for_window [app_id="page-info"] floating enable    
for_window [app_id="webconsole"] floating enable
for_window [app_id="Authy"] floating enable

for_window [app_id="termfloat"] floating enable, resize set 960 540
for_window [app_id="mpv"] floating enable, resize set 960 540
for_window [app_id="org.gnome.Nautilus"] floating enable, resize set 960 540
for_window [app_id="danmufloat"] floating enable, sticky enable, resize set 960 540

# Window Workspace Placement
for_window [app_id="icalingua"] move --no-auto-back-and-forth container to workspace QQ, focus
for_window [app_id="telegram"] move --no-auto-back-and-forth container to workspace TG, focus
for_window [class="netease-cloud-music"] move --no-auto-back-and-forth container to workspace 网易云, focus
for_window [app_id="musicfox"] move --no-auto-back-and-forth container to workspace Musicfox, focus

# ==============================================================================
# Input & Peripheral Configuration 
# ==============================================================================
input "type:touchpad" {
    tap enabled
    natural_scroll enabled
    dwt enabled
}

input "type:pointer" {
    natural_scroll enabled
    accel_profile "adaptive"
    pointer_accel 0.2
}

focus_follows_mouse yes
mouse_warping container

# ==============================================================================
# Environment & Background Services
# ==============================================================================
exec systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK
exec hash dbus-update-activation-environment 2>/dev/null && dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP

exec_always --no-startup-id mako &
exec_always --no-startup-id fcitx5 &
exec --no-startup-id nm-applet --indicator
exec_always --no-startup-id ~/.config/waybar/launch_waybar.sh &

# ==============================================================================
# Key Bindings
# ==============================================================================
# Program Execution
bindsym $mod+Return exec $term
bindsym $mod+Shift+Return exec $browser
bindsym $mod+Space exec $menu
bindsym $mod+Shift+Space exec ~/.local/bin/theme-menu
bindsym $mod+Ctrl+t exec ~/.local/bin/theme-carousel
bindsym $mod+W kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
bindsym $mod+Shift+s exec ~/.config/sway/screenshot-to-clipboard.sh
bindsym $mod+Shift+f exec $file_manager

# Navigation
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Layout & Window Management
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+s layout stacking
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen
bindsym $mod+o floating toggle
bindsym $mod+a focus parent
floating_modifier $mod normal

# Scratchpad
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# Resizing
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Sway Idle configuration
exec swayidle -w \
         timeout 300 'swaylock -f -c 000000' \
         timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
         before-sleep 'swaylock -f -c 000000'

# This will lock your screen after 300 seconds of inactivity, then turn off
# your displays after another 300 seconds, and turn your screens back on when
# resumed. It will also lock your screen before your computer goes to sleep.

# Binding to manually trigger the idle timeout and lock the screen
bindsym $mod+Escape exec killall -SIGUSR1 swayidle

# Binding to toggle Night Mode manually (or override schedule)
bindsym $mod+Shift+n exec ~/.local/bin/night-mode toggle


# ==============================================================================
# Modular Config Includes (Preserved)
# ==============================================================================
include '$(/usr/libexec/sway/layered-include "/usr/share/sway/config.d/*.conf" "/etc/sway/config.d/*.conf" "${XDG_CONFIG_HOME:-$HOME/.config}/sway/config.d/*.conf")'
