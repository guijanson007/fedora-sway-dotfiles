// LazyVim-style keymap. <leader> = space.
[
  {
    // Zed binds bare `space` to vim::Right. Because `space` is then both a complete binding and the
    // start of the leader sequences, Zed waits ~1s, runs vim::Right and replays the next key as a
    // normal motion (e.g. `s` = delete char). Unbinding it makes `space` a pure prefix, so the
    // which-key menu stays open until a command runs or ESC is pressed.
    "context": "VimControl && !menu",
    "bindings": { "space": null }
  },
  {
    "context": "vim_mode == normal && !menu",
    "bindings": {
      // files / explorer (neo-tree)
      "space e": "project_panel::ToggleFocus",
      "space shift-e": "project_panel::ToggleFocus",
      "space f e": "project_panel::ToggleFocus",
      "space space": "file_finder::Toggle",
      "space f f": "file_finder::Toggle",
      "space f shift-f": "file_finder::Toggle",
      "space f r": "projects::OpenRecent",
      "space f n": "workspace::NewFile",
      "space f t": "terminal_panel::Toggle",
      "space f shift-t": "terminal_panel::Toggle",
      "space ,": "tab_switcher::Toggle",
      "space /": "pane::DeploySearch",
      "space :": "command_palette::Toggle",

      // search
      "space s g": "pane::DeploySearch",
      "space s shift-g": "pane::DeploySearch",
      "space s r": ["pane::DeploySearch", { "replace_enabled": true }],
      "space s s": "outline::Toggle",
      "space s shift-s": "project_symbols::Toggle",
      "space s k": "zed::OpenKeymap",
      "space s d": "diagnostics::Deploy",
      "space s shift-d": "diagnostics::Deploy",

      // buffers
      "space b b": "pane::AlternateFile",
      "space `": "pane::AlternateFile",
      "space b d": "pane::CloseActiveItem",
      "space b o": "pane::CloseOtherItems",
      "space b shift-d": "pane::CloseActiveItem",
      "shift-h": "pane::ActivatePreviousItem",
      "shift-l": "pane::ActivateNextItem",
      "[ b": "pane::ActivatePreviousItem",
      "] b": "pane::ActivateNextItem",

      // windows
      "space w w": "workspace::ActivateNextPane",
      "space w d": "pane::CloseActiveItem",
      "space w h": "workspace::ActivatePaneLeft",
      "space w j": "workspace::ActivatePaneDown",
      "space w k": "workspace::ActivatePaneUp",
      "space w l": "workspace::ActivatePaneRight",
      "space w s": "pane::SplitDown",
      "space w v": "pane::SplitRight",
      "space w q": "pane::CloseActiveItem",
      "space w o": "workspace::CloseInactiveTabsAndPanes",
      "space w -": "pane::SplitDown",
      "space w |": "pane::SplitRight",
      "space -": "pane::SplitDown",
      "space |": "pane::SplitRight",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-j": "editor::AddSelectionBelow", // multiple-cursors.nvim
      "ctrl-k": "editor::AddSelectionAbove",
      "alt-j": "editor::MoveLineDown",
      "alt-k": "editor::MoveLineUp",

      // code
      "space c a": "editor::ToggleCodeActions",
      "space c r": "editor::Rename",
      "space c f": "editor::Format",
      "space c s": "outline::Toggle",
      "space c d": "editor::Hover",
      "space r s": "editor::ToggleCodeActions", // refactoring.nvim select_refactor
      "space c l": "editor::OpenExcerpts",

      // diagnostics: ]d/[d any, ]e/[e error, ]w/[w warning
      "space x x": "diagnostics::Deploy",
      "space x shift-x": "diagnostics::Deploy",
      "] d": "editor::GoToDiagnostic",
      "[ d": "editor::GoToPreviousDiagnostic",
      "] e": ["editor::GoToDiagnostic", { "severity": "error" }],
      "[ e": ["editor::GoToPreviousDiagnostic", { "severity": "error" }],
      "] w": ["editor::GoToDiagnostic", { "severity": "warning" }],
      "[ w": ["editor::GoToPreviousDiagnostic", { "severity": "warning" }],

      // git
      "space g g": ["task::Spawn", { "task_name": "lazygit" }],
      "space g shift-g": ["task::Spawn", { "task_name": "lazygit" }],
      "space g b": "git::Blame",
      "space g s": "git_panel::ToggleFocus",
      "] h": "editor::GoToHunk",
      "[ h": "editor::GoToPreviousHunk",

      // ui toggles
      "space u w": "editor::ToggleSoftWrap",
      "space u h": "editor::ToggleInlayHints",

      // quit
      "space q q": "zed::Quit",
      "space q s": "workspace::SaveAll"
    }
  },
  {
    "context": "vim_mode == visual && !menu",
    "bindings": {
      "ctrl-j": "editor::AddSelectionBelow",
      "ctrl-k": "editor::AddSelectionAbove",
      "alt-j": "editor::MoveLineDown",
      "alt-k": "editor::MoveLineUp",
      "space c a": "editor::ToggleCodeActions",
      "space r s": "editor::ToggleCodeActions",
      "space c f": "editor::Format"
    }
  },
  {
    // leader key inside the explorer, like neo-tree
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "space e": "workspace::ToggleRightDock",
      "space shift-e": "workspace::ToggleRightDock",
      "q": "workspace::ToggleRightDock",
      "space space": "file_finder::Toggle",
      "space /": "pane::DeploySearch",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "] e": "project_panel::SelectNextDiagnostic",
      "[ e": "project_panel::SelectPrevDiagnostic"
    }
  },
  {
    "context": "EmptyPane || SharedScreen",
    "bindings": {
      "space space": "file_finder::Toggle",
      "space e": "project_panel::ToggleFocus",
      "space /": "pane::DeploySearch"
    }
  },
